# Urutau — configuração local. O install.sh gera o .env a partir deste arquivo.
# Este arquivo fica só na sua máquina: o .env nunca vai para o git.

# Localização da antena, em graus decimais (negativo = sul / oeste). Use 3 casas se não quiser
# guardar a posição exata da casa (~100 m de precisão bastam para o estudo de alcance).
READSB_LAT=
READSB_LON=

# Quem pode abrir o painel: 127.0.0.1 = só esta máquina (padrão); 0.0.0.0 = rede local e Tailscale;
# 100.x.y.z = só pelo Tailscale (use o resultado de `tailscale ip -4`).
# A API em :8000 fica sempre em 127.0.0.1; só o painel (:3090) e o tar1090 (:8089) usam este BIND.
URUTAU_BIND=127.0.0.1

# Senha do painel (admin). Vazia = autenticação desligada (ok com BIND=127.0.0.1).
# Com BIND aberto, o install.sh pede (ou gera) uma senha. chmod 600 no .env.
URUTAU_PASSWORD=
# Opcional: senha só de leitura (mapa, tabelas, áudio; não troca modo nem salva config)
URUTAU_VIEW_PASSWORD=

# GID do grupo docker no host (getent group docker | cut -d: -f3)
DOCKER_GID=999

TZ=America/Sao_Paulo

# Versão das imagens prontas (latest ou, por exemplo, 0.1.0)
URUTAU_VERSION=latest

# Opcional: contato (URL ou e-mail) que o planespotters.net exige para fotos buscadas pelo servidor
PHOTO_CONTACT=
