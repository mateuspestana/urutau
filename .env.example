# Urutau — configuração local. O install.sh gera o .env a partir deste arquivo.
# Este arquivo fica só na sua máquina: o .env nunca vai para o git.

# Localização da antena, em graus decimais (negativo = sul / oeste). Use 3 casas se não quiser
# guardar a posição exata da casa (~100 m de precisão bastam para o estudo de alcance).
READSB_LAT=
READSB_LON=

# 127.0.0.1 = só esta máquina (padrão). 0.0.0.0 = qualquer aparelho da rede de casa.
URUTAU_BIND=127.0.0.1

# GID do grupo docker no host (getent group docker | cut -d: -f3)
DOCKER_GID=999

TZ=America/Sao_Paulo

# Versão das imagens prontas (latest ou, por exemplo, 0.1.0)
URUTAU_VERSION=latest

# Opcional: contato (URL ou e-mail) que o planespotters.net exige para fotos buscadas pelo servidor
PHOTO_CONTACT=
